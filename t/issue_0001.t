#!/usr/bin/env perl

BEGIN { use lib 't'; require 'testlib.pl'; }

use Modern::Perl;

spew("$test.bas", <<END);
DIM A(2)
INPUT A(1), A(2)
PRINT A(2); A(1)
END

run_ok("bfbasic $test.bas -o $test.bfpp");
check_text_file("$test.bfpp", <<'END');
// Generated by bfbasic, see https://github.com/pauloscustodio/bf
alloc_array16(A, 3)
alloc_cell16(_BFB1)
set16(_BFB1, 1)
alloc_cell16(_BFB2)
scan_cell16s(_BFB2)
put_array16(A, _BFB1, _BFB2)
free_cell16(_BFB1)
free_cell16(_BFB2)
alloc_cell16(_BFB3)
set16(_BFB3, 2)
alloc_cell16(_BFB4)
scan_cell16s(_BFB4)
put_array16(A, _BFB3, _BFB4)
free_cell16(_BFB3)
free_cell16(_BFB4)
alloc_cell16(_BFB5)
alloc_cell16(_BFB6)
set16(_BFB6, 2)
get_array16(A, _BFB6, _BFB5)
free_cell16(_BFB6)
print_cell16s(_BFB5)
free_cell16(_BFB5)
alloc_cell16(_BFB7)
alloc_cell16(_BFB8)
set16(_BFB8, 1)
get_array16(A, _BFB8, _BFB7)
free_cell16(_BFB8)
print_cell16s(_BFB7)
free_cell16(_BFB7)
print_newline
END

run_ok("bfpp $test.bfpp -o $test.bf");

capture_ok("echo 12 34 | bf $test.bf", <<END);
34 12 
END

unlink_testfiles;
done_testing;
