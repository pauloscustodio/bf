#!/usr/bin/env perl

BEGIN { use lib 't'; require 'testlib.pl'; }

use Modern::Perl;

spew("$test.bas", <<END);
FOR i = 1 TO 2
	PRINT "i=";i
	dummy()
	PRINT "i=";i
NEXT i

SUB dummy()
	FOR i = 1 TO 5
		PRINT "sub.i=";i
	NEXT i
ENDSUB
END

run_ok("bfbasic $test.bas -o $test.bfpp");
check_text_file("$test.bfpp", <<'END');
// Generated by bfbasic, see https://github.com/pauloscustodio/bf
alloc_cell16(DUMMY_1_I)
alloc_cell16(I)
alloc_cell16(_BFB1)
alloc_cell16(_BFB2)
alloc_cell16(_BFB3)
alloc_cell16(_BFB4)
set16(_BFB1, 1)
set16(_BFB2, 2)
set16(_BFB3, 1)
copy16(_BFB1, I)
copy16(_BFB3, _BFB4)
sign16(_BFB4)
if(_BFB4)
copy16(I, _BFB4)
ge16s(_BFB4, _BFB2)
else
copy16(I, _BFB4)
le16s(_BFB4, _BFB2)
endif
while(_BFB4)
print_string("i=")
print_cell16s(I)
print_newline
alloc_cell16(_BFB5)
alloc_cell16(_BFB6)
alloc_cell16(_BFB7)
alloc_cell16(_BFB8)
set16(_BFB5, 1)
set16(_BFB6, 5)
set16(_BFB7, 1)
copy16(_BFB5, DUMMY_1_I)
copy16(_BFB7, _BFB8)
sign16(_BFB8)
if(_BFB8)
copy16(DUMMY_1_I, _BFB8)
ge16s(_BFB8, _BFB6)
else
copy16(DUMMY_1_I, _BFB8)
le16s(_BFB8, _BFB6)
endif
while(_BFB8)
print_string("sub.i=")
print_cell16s(DUMMY_1_I)
print_newline
add16s(DUMMY_1_I, _BFB7)
copy16(_BFB7, _BFB8)
sign16(_BFB8)
if(_BFB8)
copy16(DUMMY_1_I, _BFB8)
ge16s(_BFB8, _BFB6)
else
copy16(DUMMY_1_I, _BFB8)
le16s(_BFB8, _BFB6)
endif
endwhile
free_cell16(_BFB5)
free_cell16(_BFB6)
free_cell16(_BFB7)
free_cell16(_BFB8)
print_string("i=")
print_cell16s(I)
print_newline
add16s(I, _BFB3)
copy16(_BFB3, _BFB4)
sign16(_BFB4)
if(_BFB4)
copy16(I, _BFB4)
ge16s(_BFB4, _BFB2)
else
copy16(I, _BFB4)
le16s(_BFB4, _BFB2)
endif
endwhile
free_cell16(_BFB1)
free_cell16(_BFB2)
free_cell16(_BFB3)
free_cell16(_BFB4)
END

run_ok("bfpp $test.bfpp -o $test.bf");

capture_ok("echo 12 34 | bf $test.bf", <<END);
i=1 
sub.i=1 
sub.i=2 
sub.i=3 
sub.i=4 
sub.i=5 
i=1 
i=2 
sub.i=1 
sub.i=2 
sub.i=3 
sub.i=4 
sub.i=5 
i=2 
END

unlink_testfiles;
done_testing;
